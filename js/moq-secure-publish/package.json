{
  "name": "@cathode-ray-tube/moq-secure-publish",
  "type": "module",
  "version": "0.1.0",
  "description": "Publish Media-over-QUIC (MoQ) broadcasts with encryption and signing",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cathode-ray-tube/moq-secure.git",
    "directory": "js/moq-secure-publish"
  },
"exports": {
  ".": "./src/index.ts"
},
  "scripts": {
    "build": "rimraf dist && vite build && tsc -p tsconfig.build.json && bun ../common/package.ts",
    "check": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "release": "bun ../common/release.ts"
  },
  "dependencies": {
    "@cathode-ray-tube/moq-secure": "0.1.10",
    "@moq/hang": "workspace:^",
    "@moq/json": "workspace:^",
    "@moq/net": "workspace:^",
    "@moq/signals": "workspace:^",
    "mediabunny": "^1.60.0"
  },
  "devDependencies": {
    "@types/audioworklet": "^0.0.100",
    "@types/bun": "^1.4.2",
    "@typescript/lib-dom": "npm:@types/web@^0.0.350",
    "esbuild": "^0.28.2",
    "rimraf": "^6.1.3",
    "typescript": "7.0.2",
    "vite": "^8.3.1"
  }
}
